# Supabase configuration
# Copy this file to .env.local and replace the values with your own.

# Project API key (Supabase dashboard -> Settings -> API Keys).
VITE_API_KEY=your-supabase-publishable-key

# Replace YOUR-PROJECT-REF with your Supabase project reference
VITE_REST_URL=https://YOUR-PROJECT-REF.supabase.co/rest/v1
VITE_AUTH_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1